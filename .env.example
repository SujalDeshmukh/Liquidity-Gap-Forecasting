# ---- Server ----
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---- MongoDB ----
MONGO_URI=mongodb://127.0.0.1:27017/liquidplus

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Path to the predefined-credentials file used by `npm run seed:users` (never commit the real file)
SEED_USERS_FILE=./seed/users.seed.json

# ---- ML service (Python FastAPI) ----
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=30000
ML_BATCH_SIZE=500

# ---- Calculations ----
# Day-count basis for simple interest (Actual/365 by default)
DAY_COUNT_BASIS=365
# Currency used when the ladder is viewed across ALL currencies
REPORTING_CURRENCY=EUR
# Static FX table (no live market feeds allowed by the PS)
FX_RATES_FILE=./src/config/fx-rates.json
# How a predicted probability p becomes an adjusted maturity:
#   linear    -> adjusted = maturity - p * remainingTenor * BEHAVIOURAL_SHIFT_FACTOR
#   threshold -> if p >= BEHAVIOURAL_THRESHOLD, adjusted = calcDate + remainingTenor * (1 - p)
#   model     -> use adjusted_maturity_date returned by the ML service (falls back to linear)
BEHAVIOURAL_ADJUSTMENT_MODE=linear
BEHAVIOURAL_SHIFT_FACTOR=1
BEHAVIOURAL_THRESHOLD=0.5

# ---- Recommendations ----
# Gaps smaller than this (in reporting/native currency units) produce no action
RECO_MIN_GAP=1000000
# Round recommended amounts to this unit
RECO_ROUND_TO=100000

# ---- Analytics ----
ANOMALY_WINDOW_DAYS=90
ANOMALY_MULTIPLIER=3

# ---- Upload / cache ----
MAX_UPLOAD_MB=50
CACHE_TTL_SECONDS=600
MAX_STORED_ERRORS=2000
