{
  "name": "liquid-plus-server",
  "version": "0.1.0",
  "private": true,
  "description": "Liquid+ application tier: Node.js + Express REST API (ingestion, gap ladders, scenarios, recommendations, RBAC)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:users": "node scripts/seedUsers.js",
    "ingest:sample": "node scripts/ingestSample.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "axios": "1.20.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.4",
    "multer": "2.4.0",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "mongodb-memory-server": "10.4.3",
    "nodemon": "3.1.14",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ]
  }
}
